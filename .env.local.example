# Copy this file to `.env.local`. All keys are optional — without any of them
# the app falls back to a deterministic mock so it still works.

# ─── AI provider ──────────────────────────────────────────────────────────────
# Pick ONE of the two below. If both are set, OpenRouter wins.

# OPTION A (recommended, FREE): OpenRouter
# Sign up free → https://openrouter.ai/keys
# Browse free models → https://openrouter.ai/models?q=free
OPENROUTER_API_KEY=
# Default free model. Other strong free options:
#   openai/gpt-oss-120b:free
#   z-ai/glm-4.5-air:free
#   openai/gpt-oss-20b:free
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Optional — shown in your OpenRouter dashboard.
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=TubeForecaster

# OPTION B (PAID, pay-per-token): OpenAI direct
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ─── YouTube Data API v3 (optional but recommended) ───────────────────────────
# Enables real channel info + competitive lookup of similar videos.
# Create one at https://console.cloud.google.com/apis/credentials and enable
# "YouTube Data API v3". The free quota is 10,000 units/day.
YOUTUBE_API_KEY=
